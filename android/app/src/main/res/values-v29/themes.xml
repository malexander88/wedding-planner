<resources>
    <!-- DayNight so the web app's prefers-color-scheme follows the phone's dark mode. -->
    <style name="Theme.WeddingPlanner" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/forest</item>
        <item name="android:navigationBarColor">@color/forest</item>
        <item name="android:colorPrimary">@color/forest</item>
        <item name="android:colorAccent">#C9A55C</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
